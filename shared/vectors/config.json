[
  { "name": "empty object gives every default", "json": "{}", "expect": { "enabled": true, "fixTyped": "Shift+CapsLock+Tab", "fixSelection": "Shift+CapsLock+Backquote", "switchLayoutAfterFix": true, "latinLayout": "auto", "arabicLayout": "auto", "maxRunLength": 1000, "clipboardTimeoutMs": 400, "pasteRestoreDelayMs": 300, "releaseTimeoutMs": 3000 } },
  { "name": "the default file parses to itself", "json": "{\"enabled\": true, \"hotkeys\": {\"fixTyped\": \"Shift+CapsLock+Tab\", \"fixSelection\": \"Shift+CapsLock+Backquote\"}, \"switchLayoutAfterFix\": true, \"layouts\": {\"latin\": \"auto\", \"arabic\": \"auto\"}, \"maxRunLength\": 1000, \"clipboardTimeoutMs\": 400, \"pasteRestoreDelayMs\": 300, \"releaseTimeoutMs\": 3000}", "expect": { "fixTyped": "Shift+CapsLock+Tab", "maxRunLength": 1000 } },
  { "name": "one field changes, the rest keep defaults", "json": "{\"enabled\": false}", "expect": { "enabled": false, "fixTyped": "Shift+CapsLock+Tab", "switchLayoutAfterFix": true } },
  { "name": "hotkey names are trimmed and case-insensitive", "json": "{\"hotkeys\": {\"fixTyped\": \"ctrl + alt + F9\"}}", "expect": { "fixTyped": "Ctrl+Alt+F9", "fixSelection": "Shift+CapsLock+Backquote" } },
  { "name": "backtick means Backquote", "json": "{\"hotkeys\": {\"fixSelection\": \"Win+`\"}}", "expect": { "fixSelection": "Win+Backquote" } },
  { "name": "hold keys in any order, repeats count once", "json": "{\"hotkeys\": {\"fixTyped\": \"CapsLock+Shift+Shift+F2\"}}", "expect": { "fixTyped": "Shift+CapsLock+F2" } },
  { "name": "explicit layouts are stored uppercase", "json": "{\"layouts\": {\"latin\": \"04090409\", \"arabic\": \"04012c01\"}}", "expect": { "latinLayout": "04090409", "arabicLayout": "04012C01" } },
  { "name": "auto in any case", "json": "{\"layouts\": {\"latin\": \"AUTO\"}}", "expect": { "latinLayout": "auto", "arabicLayout": "auto" } },
  { "name": "range boundaries are allowed", "json": "{\"maxRunLength\": 10, \"clipboardTimeoutMs\": 10000, \"pasteRestoreDelayMs\": 50, \"releaseTimeoutMs\": 50}", "expect": { "maxRunLength": 10, "clipboardTimeoutMs": 10000, "pasteRestoreDelayMs": 50, "releaseTimeoutMs": 50 } },
  { "name": "switchLayoutAfterFix can be turned off", "json": "{\"switchLayoutAfterFix\": false}", "expect": { "switchLayoutAfterFix": false } },

  { "name": "trailing comma", "json": "{\"enabled\": true,}", "error": "json.invalid" },
  { "name": "empty text", "json": "", "error": "json.invalid" },
  { "name": "root is an array", "json": "[1, 2]", "error": "json.invalid" },
  { "name": "repeated field", "json": "{\"enabled\": true, \"enabled\": false}", "error": "json.invalid" },
  { "name": "repeated nested field", "json": "{\"hotkeys\": {\"fixTyped\": \"Ctrl+F1\", \"fixTyped\": \"Ctrl+F2\"}}", "error": "json.invalid" },
  { "name": "a repeated field is found before an earlier field error", "json": "{\"colour\": 1, \"enabled\": true, \"enabled\": false}", "error": "json.invalid" },
  { "name": "NaN is not JSON", "json": "{\"maxRunLength\": NaN}", "error": "json.invalid" },
  { "name": "unknown top-level field", "json": "{\"colour\": \"red\"}", "error": "field.unknown" },
  { "name": "field names are case-sensitive", "json": "{\"Enabled\": true}", "error": "field.unknown" },
  { "name": "unknown hotkey field", "json": "{\"hotkeys\": {\"fixAll\": \"Shift+Tab\"}}", "error": "field.unknown" },
  { "name": "unknown layouts field", "json": "{\"layouts\": {\"hebrew\": \"auto\"}}", "error": "field.unknown" },
  { "name": "bool given as string", "json": "{\"enabled\": \"yes\"}", "error": "field.type" },
  { "name": "hotkeys given as string", "json": "{\"hotkeys\": \"Shift+Tab\"}", "error": "field.type" },
  { "name": "hotkey given as number", "json": "{\"hotkeys\": {\"fixTyped\": 9}}", "error": "field.type" },
  { "name": "number with a decimal point", "json": "{\"maxRunLength\": 1000.0}", "error": "field.type" },
  { "name": "number with an exponent", "json": "{\"maxRunLength\": 1e3}", "error": "field.type" },
  { "name": "number given as string", "json": "{\"releaseTimeoutMs\": \"3000\"}", "error": "field.type" },
  { "name": "layout given as null", "json": "{\"layouts\": {\"latin\": null}}", "error": "field.type" },
  { "name": "below range", "json": "{\"maxRunLength\": 9}", "error": "number.range" },
  { "name": "above range", "json": "{\"pasteRestoreDelayMs\": 10001}", "error": "number.range" },
  { "name": "negative", "json": "{\"clipboardTimeoutMs\": -400}", "error": "number.range" },
  { "name": "too big for 64 bits", "json": "{\"clipboardTimeoutMs\": 99999999999999999999}", "error": "number.range" },
  { "name": "misspelled trigger", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift+Tabb\"}}", "error": "hotkey.unknownKey" },
  { "name": "empty name between plus signs", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift++Tab\"}}", "error": "hotkey.unknownKey" },
  { "name": "empty hotkey", "json": "{\"hotkeys\": {\"fixTyped\": \"\"}}", "error": "hotkey.unknownKey" },
  { "name": "misspelled hold key", "json": "{\"hotkeys\": {\"fixTyped\": \"Shfit+Tab\"}}", "error": "hotkey.unknownKey" },
  { "name": "no hold key", "json": "{\"hotkeys\": {\"fixTyped\": \"Tab\"}}", "error": "hotkey.noHoldKey" },
  { "name": "letter before the trigger", "json": "{\"hotkeys\": {\"fixTyped\": \"KeyA+Tab\"}}", "error": "hotkey.notHoldKey" },
  { "name": "sided modifier name before the trigger", "json": "{\"hotkeys\": {\"fixTyped\": \"ShiftLeft+Tab\"}}", "error": "hotkey.notHoldKey" },
  { "name": "hold key as trigger", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift+CapsLock\"}}", "error": "hotkey.triggerIsModifier" },
  { "name": "lock key as trigger", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift+NumLock\"}}", "error": "hotkey.triggerIsModifier" },
  { "name": "same chord as the default of the other hotkey", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift+CapsLock+Backquote\"}}", "error": "hotkey.duplicate" },
  { "name": "same chord written differently", "json": "{\"hotkeys\": {\"fixTyped\": \"Ctrl+F9\", \"fixSelection\": \"ctrl+f9\"}}", "error": "hotkey.duplicate" },
  { "name": "short layout", "json": "{\"layouts\": {\"arabic\": \"0401\"}}", "error": "layout.invalid" },
  { "name": "layout with a non-hex digit", "json": "{\"layouts\": {\"arabic\": \"0401ZC01\"}}", "error": "layout.invalid" },
  { "name": "first error in document order wins", "json": "{\"enabled\": \"yes\", \"colour\": 1}", "error": "field.type" },
  { "name": "hotkey error before a later range error", "json": "{\"hotkeys\": {\"fixTyped\": \"Tab\"}, \"maxRunLength\": 1}", "error": "hotkey.noHoldKey" },
  { "name": "duplicate chords are checked after every field", "json": "{\"hotkeys\": {\"fixTyped\": \"Shift+CapsLock+Backquote\"}, \"maxRunLength\": 1}", "error": "number.range" },
  { "name": "a bool in a number field", "json": "{\"maxRunLength\": true}", "error": "field.type" },
  { "name": "Infinity is not JSON", "json": "{\"maxRunLength\": Infinity}", "error": "json.invalid" },
  { "name": "negative Infinity is not JSON", "json": "{\"clipboardTimeoutMs\": -Infinity}", "error": "json.invalid" },
  { "name": "layout with a 0x prefix", "json": "{\"layouts\": {\"latin\": \"0x012C01\"}}", "error": "layout.invalid" },
  { "name": "layout with an underscore", "json": "{\"layouts\": {\"arabic\": \"0401_C01\"}}", "error": "layout.invalid" }
]
